# Owner token; devices pair instead of carrying it. Leave it empty and the
# server generates one on first start and prints it once. At least 32
# characters to supply your own: openssl rand -hex 32.
OMNISAVE_TOKEN=
# OMNISAVE_TOKEN_FILE=/run/secrets/omnisave-token

# Server and storage.
#
# OMNISAVE_STORE_DIR is the save store: one directory holding everything needed
# to recover the saves in it, with instructions inside. It is the thing to back
# up and the thing that can be copied elsewhere.
#
# The database is an index over the store, and lives outside it because it
# carries credentials and the owner PIN — secrets that must not travel with a
# directory meant to be copied. Losing it loses nothing a save needs: the
# server rebuilds the index from the store on the next start.
OMNISAVE_LISTEN_ADDR=:8080
OMNISAVE_STORE_DIR=./store
OMNISAVE_DB_PATH=./omnisave.db
OMNISAVE_WEB_DIR=./apps/dash/dist

# Local network discovery. OMNISAVE_NAME defaults to the host name; announcing
# is an owner setting in the Dash, and OMNISAVE_DISCOVERY pins it here instead.
# OMNISAVE_NAME=
# OMNISAVE_DISCOVERY=true

# Compose deployment. These configure the published image and the host port it
# is bound to; the container's own paths come from the image defaults.
OMNISAVE_VERSION=latest
OMNISAVE_PORT=8080
OMNISAVE_BIND_ADDRESS=0.0.0.0

# Hasheous catalog provider
OMNISAVE_HASHEOUS_BASE_URL=https://hasheous.org
OMNISAVE_HASHEOUS_TIMEOUT=15s

# IGDB catalog provider. Leave these empty and the owner sets them under
# Server in the Dash, where they take effect without a restart; setting them
# here pins them for the deployment instead.
OMNISAVE_IGDB_CLIENT_ID=
OMNISAVE_IGDB_CLIENT_SECRET=
OMNISAVE_IGDB_BASE_URL=https://api.igdb.com/v4
OMNISAVE_IGDB_TOKEN_URL=https://id.twitch.tv/oauth2/token
OMNISAVE_IGDB_IMAGE_BASE_URL=https://images.igdb.com/igdb/image/upload
OMNISAVE_IGDB_TIMEOUT=15s
OMNISAVE_IGDB_REQUESTS_PER_SECOND=4
OMNISAVE_IGDB_SEARCH_CACHE_TTL=5m
