#!/bin/sh
# postinst — runs after package files are extracted.

PACKAGE="OmniSave"
ETC_DIR="/var/packages/${PACKAGE}/etc"
CONFIG="${ETC_DIR}/server.yaml"

mkdir -p "${ETC_DIR}"
mkdir -p "/volume1/omnisave/data/artifacts"

# Write a default config if one doesn't already exist.
if [ ! -f "${CONFIG}" ]; then
    cat > "${CONFIG}" << 'EOF'
listen_addr: :8080
token: CHANGE_ME
db_path: /volume1/omnisave/data/omnisave.db
artifact_dir: /volume1/omnisave/data/artifacts
EOF
    echo ""
    echo "================================================"
    echo " OmniSave: default config written to:"
    echo "   ${CONFIG}"
    echo ""
    echo " Edit it and set a strong 'token' before starting."
    echo "================================================"
fi

exit 0
