#!/bin/sh
# postinst — runs after package files are extracted.

PACKAGE="Omnisave"
ETC_DIR="/var/packages/${PACKAGE}/etc"
ENVIRONMENT="${ETC_DIR}/server.env"

mkdir -p "${ETC_DIR}"
mkdir -p "/volume1/omnisave/data/artifacts"

# Write the package's exported environment if it does not already exist.
if [ ! -f "${ENVIRONMENT}" ]; then
    TOKEN="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
    umask 077
    cat > "${ENVIRONMENT}" << EOF
OMNISAVE_LISTEN_ADDR=:8080
OMNISAVE_TOKEN=${TOKEN}
OMNISAVE_DB_PATH=/volume1/omnisave/data/omnisave.db
OMNISAVE_ARTIFACT_DIR=/volume1/omnisave/data/artifacts
OMNISAVE_WEB_DIR=/var/packages/Omnisave/target/web
EOF
    echo ""
    echo "================================================"
    echo " Omnisave environment written to:"
    echo "   ${ENVIRONMENT}"
    echo "================================================"
fi

exit 0
