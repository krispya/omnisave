#!/bin/sh
# postinst — runs after package files are extracted.

PACKAGE="OmniSave"
ETC_DIR="/var/packages/${PACKAGE}/etc"
CONFIG="${ETC_DIR}/server.yaml"

mkdir -p "${ETC_DIR}"
mkdir -p "/volume1/omnisave/saves"

# Write a default config if one doesn't already exist.
if [ ! -f "${CONFIG}" ]; then
    cat > "${CONFIG}" << 'EOF'
root_dir: /volume1/omnisave/saves
token: CHANGE_ME
domain: ""      # Set to your domain for automatic HTTPS via Let's Encrypt
cache_dir: /volume1/omnisave/certs
db_path: /volume1/omnisave/omnisave.db
EOF
    echo ""
    echo "================================================"
    echo " OmniSave: default config written to:"
    echo "   ${CONFIG}"
    echo ""
    echo " Edit it and set a strong 'token' before starting."
    echo "================================================"
fi

exit 0
