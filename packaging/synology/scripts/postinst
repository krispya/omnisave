#!/bin/sh
# postinst — runs after package files are extracted.

PACKAGE="${SYNOPKG_PKGNAME:-omnisave}"
PACKAGE_ROOT="/var/packages/${PACKAGE}"

# Paths below are written into a file the server reads on every later start, so
# they use the stable /var/packages symlinks rather than SYNOPKG_PKGVAR and
# SYNOPKG_PKGDEST. Those variables resolve to volume-specific @appdata and
# @appstore paths, which change when the package is moved to another volume.
ETC_DIR="${PACKAGE_ROOT}/etc"
VAR_DIR="${PACKAGE_ROOT}/var"
ENVIRONMENT="${ETC_DIR}/server.env"

mkdir -p "${ETC_DIR}" "${VAR_DIR}/artifacts"

# The owner token is generated here rather than asked for (ADR-010). Nobody
# installing a package on their own NAS has a reason to invent 64 hexadecimal
# characters, and this is the one moment DSM reliably shows text to the person
# doing it. od reads /dev/urandom without depending on openssl being present.
generate_token() {
    od -vAn -N32 -tx1 /dev/urandom | tr -d ' \n'
}

current_token() {
    [ -f "${ENVIRONMENT}" ] || return 1
    TOKEN_LINE=$(grep '^OMNISAVE_TOKEN=' "${ENVIRONMENT}" | tail -n 1)
    TOKEN=${TOKEN_LINE#OMNISAVE_TOKEN=}
    [ -n "${TOKEN}" ] && printf '%s' "${TOKEN}"
}

umask 077
if [ ! -f "${ENVIRONMENT}" ]; then
    OWNER_TOKEN=$(generate_token)
    cat > "${ENVIRONMENT}" << SETTINGS
OMNISAVE_LISTEN_ADDR=:8080
OMNISAVE_TOKEN=${OWNER_TOKEN}
OMNISAVE_DB_PATH=${VAR_DIR}/omnisave.db
OMNISAVE_ARTIFACT_DIR=${VAR_DIR}/artifacts
OMNISAVE_WEB_DIR=${PACKAGE_ROOT}/target/web
SETTINGS
else
    # DSM keeps etc across an uninstall, so a reinstall finds the previous
    # installation's file. Keep every setting the operator may have edited,
    # including the token they already gave their devices, and fill in a token
    # only if that file somehow has none.
    OWNER_TOKEN=$(current_token)
    if [ -z "${OWNER_TOKEN}" ]; then
        OWNER_TOKEN=$(generate_token)
        grep -v '^OMNISAVE_TOKEN=' "${ENVIRONMENT}" > "${ENVIRONMENT}.new"
        echo "OMNISAVE_TOKEN=${OWNER_TOKEN}" >> "${ENVIRONMENT}.new"
        mv "${ENVIRONMENT}.new" "${ENVIRONMENT}"
    fi
fi

cat > "${SYNOPKG_TEMP_LOGFILE}" << MESSAGE
Omnisave owner token:

    ${OWNER_TOKEN}

Open Omnisave and enter it once; it is traded for a credential this browser
keeps, and connected devices never carry it. It is stored in
${ENVIRONMENT}, which you can edit to set your own.
MESSAGE

exit 0
